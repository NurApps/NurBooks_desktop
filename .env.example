# NurBooks — переменные окружения.
# Скопируйте этот файл в .env и заполните значения. НЕ коммитьте .env!
#
# Сгенерировать ключ:  python -c "import secrets; print(secrets.token_urlsafe(32))"

# Ключ API сервера — должен совпадать с NURBOOKS_API_KEY на Render
NURBOOKS_API_KEY=

# Firebase Web API Key (консоль Firebase → Project settings → General → Web API Key)
# НЕ путать с ключом сервисного аккаунта (serviceAccountKey.json)!
FIREBASE_API_KEY=

# GitHub Personal Access Token — только для автоматических релизов (необязательно)
GITHUB_TOKEN=

# URL API-сервера (по умолчанию продакшн)
API_BASE_URL=https://nurbooks-api.onrender.com
